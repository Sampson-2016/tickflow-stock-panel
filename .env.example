# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth (访问凭证) =====
# .env 是密码**唯一**明文所在。代码里没有默认密码, auth.json 只存 PBKDF2 哈希。
#
# AUTH_PASSWORD (必填, ≥ 6 位)
#   - 后端每次启动都从 .env 读取, hash 后同步到 data/user_data/auth.json
#   - 改密码: 改这里 + 重启后端, 旧会话自动失效
#   - .env 没设 且 auth.json 也不存在 → 后端拒绝启动 (避免无密码裸跑)
#   - .env 没设 但 auth.json 已有 → 沿用现有密码 (不会清掉)
#
# AUTH_USERNAME (可选, 默认 admin, 一般不用改)
#   - 改这里 + 重启, 同步到 auth.json 的 username 字段
#
# ⚠️ 真实 .env 不要提交到 git (已在 .gitignore); 本文件是模板可以提交
# ⚠️ 写密码时别加单引号 ('xxx'), pydantic-settings 会按字面读, 引号会算进密码
AUTH_PASSWORD=
# AUTH_USERNAME=admin

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data
